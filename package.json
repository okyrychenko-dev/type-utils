{
  "name": "@okyrychenko-dev/type-utils",
  "version": "0.1.2",
  "type": "module",
  "description": "Type-safe guards, assertions, and utility types for narrowing unknown values in TypeScript",
  "homepage": "https://github.com/okyrychenko-dev/type-utils#readme",
  "bugs": {
    "url": "https://github.com/okyrychenko-dev/type-utils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okyrychenko-dev/type-utils.git"
  },
  "license": "MIT",
  "author": "Oleksii Kyrychenko alexey.kirichenko@gmail.com",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "release:check": "npm run check && npm run package:check",
    "prepublishOnly": "npm run release:check",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.config.json",
    "lint": "eslint src scripts *.config.ts eslint.config.mjs --ext .ts,.mjs",
    "lint:fix": "npm run lint -- --fix",
    "format": "npm run lint:fix && prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "package:check": "node scripts/check-packed-package.mjs && attw --pack . && publint",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "typescript",
    "type-guards",
    "type-safety",
    "assertions",
    "narrowing",
    "type-narrowing",
    "utility-types",
    "runtime-validation",
    "exhaustive-check"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
